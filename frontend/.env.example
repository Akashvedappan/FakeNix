# FAKENIX 2.0 Environment Variables
# Copy this file to .env and update values

# Flask Backend API URL
VITE_API_BASE_URL=http://localhost:5000/api

# Demo mode is controlled by the backend (DEMO_MODE in backend/.env).
# Results produced in backend demo mode are labelled "DEMO ANALYSIS" in the UI.

# App name
VITE_APP_NAME=FAKENIX
